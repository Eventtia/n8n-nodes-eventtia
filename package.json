{
  "name": "@eventtia/n8n-nodes-eventtia",
  "version": "0.2.1",
  "description": "n8n community node to read and manage events, attendees, speakers and payments in the Eventtia Connect API",
  "license": "MIT",
  "homepage": "https://github.com/eventtia/n8n-nodes-eventtia",
  "keywords": [
    "n8n-community-node-package",
    "eventtia",
    "events",
    "attendees",
    "event-management",
    "registration"
  ],
  "author": {
    "name": "Eventtia",
    "email": "dev@eventtia.com",
    "url": "https://www.eventtia.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Eventtia/n8n-nodes-eventtia.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/EventtiaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Eventtia/Eventtia.node.js",
      "dist/nodes/Eventtia/EventtiaTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.45.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
